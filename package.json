{
  "name": "chronicle",
  "version": "0.1.0",
  "description": "A personal history timeline you build as you learn",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "check:quiet": "tsc --noEmit --pretty false && vitest run --reporter=dot --silent && vite build --logLevel warn && playwright test --reporter=dot --quiet",
    "shots": "node scripts/screenshots.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "idb": "^8.0.4",
    "maplibre-gl": "6.11.2",
    "moment": "^2.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vis-data": "^8.0.5",
    "vis-timeline": "^8.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module"
}
