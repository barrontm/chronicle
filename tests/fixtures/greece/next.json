links":[{"from":"assembly","to":"archons","kind":"elects","label":"elects, then lot"},{"from":"council","to":"assembly","kind":"advises"},{"from":"courts","to":"archons","kind":"checks","label":"hears appeals"},{"from":"areopagus","to":"archons","kind":"checks","label":"guards the laws"}],"say":{"vote":null,"power":null,"powerLabel":"the richest classes hold office","note":"No reliable numbers before the 5th century."},"changes":["Citizens are sorted into four classes by the size of their harvest; office follows wealth, not birth.","A new Council of 400 prepares business for the Assembly.","Any citizen can appeal to the people's court.","Debts are cancelled and enslavement for debt ends."]},{"id":"tyranny","title":"Tyranny of the Peisistratids","form":"tyranny","from":-560,"to":-509,"institutions":[{"id":"tyrant","name":"Tyrant","size":1,"note":"Peisistratus, then Hippias"},{"id":"archons","name":"Archons","size":9,"note":"the tyrant's men"},{"id":"areopagus","name":"Areopagus","size":null,"note":"in name only","nominal":true},{"id":"council","name":"Council","size":400,"note":"in name only","nominal":true},{"id":"assembly","name":"Assembly","size":null,"note":"in name only","nominal":true}],"links":[{"from":"tyrant","to":"archons","kind":"appoints"}],"say":{"vote":null,"power":1,"powerLabel":"one man","note":"No reliable numbers before the 5th century."},"changes":["Peisistratus takes power with a bodyguard; Solon's institutions stay, but he decides who holds office.","His son Hippias rules until Sparta helps drive him out in 510."]},{"id":"cleisthenes","title":"Cleisthenes' democracy","form":"democracy","from":-507,"to":-461,"institutions":[{"id":"archons","name":"Archons","size":9,"note":"9, elected"},{"id":"generals","name":"Generals","size":10,"note":"10, elected"},{"id":"areopagus","name":"Areopagus","size":[100,200],"note":"former archons"},{"id":"council","name":"Council","size":500,"note":"500, 50 per tribe"},{"id":"courts","name":"People's court","size":null,"note":"any citizen can appeal"},{"id":"assembly","name":"Assembly","size":null,"note":"all citizens"}],"links":[{"from":"assembly","to":"generals","kind":"elects"},{"from":"assembly","to":"archons","kind":"elects"},{"from":"council","to":"assembly","kind":"advises"},{"from":"areopagus","to":"archons","kind":"checks","label":"guards the laws"}],"say":{"vote":30000,"note":"Herodotus speaks of 30,000 Athenians about 500 BCE; the rest of the population is not known."},"changes":["Ten new tribes each mix citizens from the coast, the city and the inland.","A Council of 500, fifty from each tribe, prepares business for the Assembly.","Ten generals are elected each year, from 501.","Ostracism: the Assembly can send one man away for ten years (first used in 487)."]},{"id":"radical","title":"Radical democracy","form":"democracy","from":-461,"to":-409.55,"institutions":[{"id":"archons","name":"Archons","size":9,"note":"9, by lot"},{"id":"generals","name":"Generals","size":10,"note":"10, elected"},{"id":"areopagus","name":"Areopagus","size":[100,200],"note":"murder trials only","nominal":true},{"id":"council","name":"Council","size":500,"note":"500, by lot"},{"id":"courts","name":"People's courts","size":6000,"note":"6,000 jurors, by lot"},{"id":"assembly","name":"Assembly","size":6000,"note":"about 6,000 attend"}],"links":[{"from":"citizens","to":"council","kind":"elects","label":"by lot"},{"from":"citizens","to":"courts","kind":"elects","label":"by lot"},{"from":"assembly","to":"generals","kind":"elects"},{"from":"council","to":"assembly","kind":"advises"},{"from":"courts","to":"archons","kind":"checks","label":"audit officials"},{"from":"courts","to":"assembly","kind":"checks","label":"can strike down decrees"}],"say":{"total":[250000,350000],"enslaved":[80000,120000],"vote":[40000,60000]},"changes":["The Areopagus loses its powers except for murder trials; the Council, the Assembly and the courts take them over.","Jurors are paid from about 450, so the poor can serve.","Archons are open to the third class (457).","From 451, only children of two Athenian parents are citizens."]},{"id":"four","title":"The Four Hundred","form":"oligarchy","from":-409.55,"to":-409.28,"institutions":[{"id":"four","name":"The Four Hundred","size":400,"note":"400, hand-picked"},{"id":"generals","name":"Generals","size":10,"note":"appointed by them"},{"id":"fivek","name":"The Five Thousand","size":5000,"note":"on paper only","nominal":true}],"links":[{"from":"four","to":"generals","kind":"appoints"}],"say":{"total":[200000,300000],"enslaved":[70000,110000],"vote":5000,"voteNominal":true,"power":400,"powerLabel":"the Four Hundred"},"changes":["With the war going badly, an assembly at Colonus votes the democracy away.","Four hundred men rule in place of the Council; the Five Thousand exist on paper only.","They fall after four months, when the fleet at Samos refuses to obey them."]},{"id":"fivek","title":"The Five Thousand","form":"oligarchy","from":-409.28,"to":-408.55,"institutions":[{"id":"fivek","name":"The Five Thousand","size":[5000,9000],"note":"men who can afford armour"},{"id":"council","name":"Council","size":null,"note":"chosen by them"},{"id":"generals","name":"Generals","size":10,"note":"10, elected"},{"id":"archons","name":"Archons","size":9,"note":"9"}],"links":[{"from":"fivek","to":"generals","kind":"elects"},{"from":"fivek","to":"council","kind":"elects"}],"say":{"total":[200000,300000],"enslaved":[70000,110000],"vote":[5000,9000]},"changes":["Only men who can afford hoplite armour vote: about 5,000, perhaps more.","Pay for office ends."]},{"id":"restored","title":"Democracy restored","form":"democracy","from":-408.55,"to":-402.7,"institutions":[{"id":"archons","name":"Archons","size":9,"note":"9, by lot"},{"id":"generals","name":"Generals","size":10,"note":"10, elected"},{"id":"areopagus","name":"Areopagus","size":[100,200],"note":"murder trials only","nominal":true},{"id":"council","name":"Council","size":500,"note":"500, by lot"},{"id":"courts","name":"People's courts","size":6000,"note":"6,000 jurors, by lot"},{"id":"assembly","name":"Assembly","size":6000,"note":"about 6,000 attend"}],"links":[{"from":"citizens","to":"council","kind":"elects","label":"by lot"},{"from":"citizens","to":"courts","kind":"elects","label":"by lot"},{"from":"assembly","to":"generals","kind":"elects"},{"from":"council","to":"assembly","kind":"advises"},{"from":"courts","to":"archons","kind":"checks","label":"audit officials"},{"from":"courts","to":"assembly","kind":"checks","label":"can strike down decrees"}],"say":{"total":[200000,300000],"enslaved":[70000,110000],"vote":[25000,35000]},"changes":["The full democracy returns after the victory at Cyzicus.","After Arginusae (406), the Assembly tries six generals together and has them executed."]},{"id":"thirty","title":"The Thirty","form":"oligarchy","from":-402.7,"to":-401.3,"client":"Sparta","institutions":[{"id":"thirty","name":"The Thirty","size":30,"note":"30, named under Lysander"},{"id":"eleven","name":"The Eleven","size":11,"note":"arrests and executions"},{"id":"council","name":"Council","size":500,"note":"picked by the Thirty"},{"id":"threek","name":"The Three Thousand","size":3000,"note":"the only citizens left"},{"id":"sparta","name":"Spartan garrison","size":700,"note":"700 on the Acropolis"}],"links":[{"from":"sparta","to":"thirty","kind":"appoints","label":"imposed by Lysander"},{"from":"thirty","to":"eleven","kind":"commands"},{"from":"thirty","to":"council","kind":"appoints"},{"from":"thirty","to":"threek","kind":"appoints","label":"draws up the list"}],"say":{"total":[180000,260000],"enslaved":[60000,100000],"vote":3000,"power":30,"powerLabel":"the Thirty"},"changes":["Under Lysander's eye, the Assembly names thirty men to rewrite the laws.","Only the Three Thousand keep their rights; about 1,500 people are killed.","A Spartan garrison holds the Acropolis."]},{"id":"fourth","title":"The restored democracy","form":"democracy","from":-401.3,"to":-321,"insti