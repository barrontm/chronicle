,[26.192,40.024],[25.547,39.757],[24.741,38.809],[24.644,37.983],[24.612,37.983],[24.031,37.57],[23.676,37.837],[23.644,37.91],[23.644,37.934],[23.636,37.942]]},{"id":"timber","name":"Ship timber from Macedon","label":[23.55,39.62],"periods":[[-482,-321,"on",null]],"points":[[22.58,40.42],[22.612,40.413],[22.644,40.413],[23.354,39.951],[23.386,39.951],[23.354,39.927],[23.547,39.149],[23.515,39.052],[24.16,38.955],[24.676,38.08],[24.612,37.983],[24.031,37.57],[23.676,37.837],[23.644,37.91],[23.644,37.934],[23.636,37.942]]},{"id":"euboea","name":"Food and flocks from Euboea, overland","inset":true,"periods":[[-505,-411.8,"on",null],[-411.8,-409.25,"cut",null,"Spartans hold Decelea"],[-377,-321,"on",null]],"cutAt":[23.79,38.17],"points":[[23.795,38.395],[23.75,38.31],[23.79,38.17],[23.727,37.972]]},{"id":"euboeaSea","name":"Food from Euboea, by sea round Sounion","inset":true,"periods":[[-411.8,-409.25,"on",null]],"points":[[23.8,38.38],[23.8,38.38],[23.986,38.275],[24.08,38.199],[24.099,38.05],[24.09,37.655],[24.021,37.6],[23.954,37.663],[23.756,37.819],[23.621,37.931],[23.62,37.93]]}]},"overview":{"alliances":{"t_delian":{"leader":"t_athens"}}},"article":{"title":"Peloponnesian War","sentences":[{"id":"s1","section":"","text":"The Peloponnesian War (431–404 BC) was fought between Athens with its empire, the Delian League, and Sparta with its allies in the Peloponnesian League."},{"id":"s2","section":"","text":"Historians usually divide it into three phases."},{"id":"s3","section":"Archidamian War","text":"In the first phase the Spartan king Archidamus II invaded Attica almost every summer, while Athens, safe behind its Long Walls, raided the coast of the Peloponnese with its fleet."},{"id":"s4","section":"Archidamian War","text":"This phase, the Archidamian War, lasted from 431 to 421 BC."},{"id":"s5","section":"Archidamian War","text":"In 430 BC a plague broke out in the crowded city; it killed perhaps a quarter of the people, Pericles among them."},{"id":"s6","section":"Archidamian War","text":"In 425 BC the Athenians captured some 120 Spartans on the island of Sphacteria, near Pylos."},{"id":"s7","section":"The Peace of Nicias and the Sicilian Expedition","text":"The Peace of Nicias, made in 421 BC, was meant to last fifty years."},{"id":"s8","section":"The Peace of Nicias and the Sicilian Expedition","text":"In 415 BC Athens sent a great fleet against Syracuse in Sicily; by 413 BC the whole force had been destroyed."},{"id":"s9","section":"The Peace of Nicias and the Sicilian Expedition","text":"Alcibiades, one of its commanders, was recalled to face a charge of impiety and fled to Sparta instead."},{"id":"s10","section":"The Decelean War","text":"In 413 BC, on his advice, the Spartans fortified Decelea in Attica, cutting Athens off from its farms and from the silver mines at Laurion."},{"id":"s11","section":"The Decelean War","text":"After the disaster in Sicily an oligarchy of Four Hundred took power in Athens in 411 BC."},{"id":"s12","section":"Defeat of Athens","text":"In 405 BC the Spartan admiral Lysander destroyed the last Athenian fleet at Aegospotami in the Hellespont."},{"id":"s13","section":"Defeat of Athens","text":"Starved by blockade, Athens surrendered in the spring of 404 BC."},{"id":"s14","section":"Defeat of Athens","text":"Sparta set up an oligarchy, the Thirty, which ruled by terror until democracy was restored in 403 BC."}],"have":[{"id":"athens","t":"Athens (Attica)","kind":"polity","region":"Greece"},{"id":"sparta","t":"Sparta (Laconia and Messenia)","kind":"polity","region":"Greece"},{"id":"persia","t":"Achaemenid Persia","kind":"polity","region":"Persia"},{"id":"pericles","t":"Pericles","kind":"person","a":-494,"b":-428,"approxA":true,"lanes":["politics"],"in":"athens"}],"entries":[{"id":"war","t":"Peloponnesian War","kind":"war","a":-430,"b":-403,"lanes":["war"],"by":"code","q":"s1"},{"id":"arch","t":"Archidamian War","kind":"span","a":-430,"b":-420,"lanes":["war"],"by":"claude","q":"s4","partOf":"