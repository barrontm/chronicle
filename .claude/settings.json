{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsc --noEmit > /tmp/chronicle-typecheck.log 2>&1 || { echo 'Typecheck failed after this edit:' >&2; head -15 /tmp/chronicle-typecheck.log >&2; exit 2; }",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright test*)",
      "Bash(npx tsc*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(public/geo/**)",
      "Read(package-lock.json)",
      "Read(dist/**)",
      "Read(node_modules/**/dist/*.mjs)"
    ]
  }
}
