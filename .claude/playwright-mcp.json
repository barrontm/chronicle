{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "args": ["--use-angle=swiftshader", "--enable-unsafe-swiftshader"]
    },
    "contextOptions": { "viewport": { "width": 1440, "height": 900 } }
  },
  "outputDir": "screenshots/mcp"
}
